<!doctype html><meta charset="utf-8"><style>body{background:#101827;color:#fff;font:30px Arial;padding:55px}#state{color:#64edb0}</style><h1>Puente temporal Vizio</h1><p id="state">Conectando con la PC…</p><p>Puente de instalación temporal. Ejecuta únicamente planes que hayas revisado.</p><script>
var host='http://__HOST__:8099',key='__TOKEN__',stopped=false;
function status(s){document.getElementById('state').textContent=s;}
function request(url,method,data,cb){var x=new XMLHttpRequest();x.open(method,url);x.timeout=12000;x.onload=function(){cb(null,x.status,x.responseText);};x.onerror=function(){cb('Sin conexión');};x.ontimeout=function(){cb('Tiempo agotado');};x.send(data||null);}
function poll(){if(stopped)return;request(host+'/job?key='+key,'GET',null,function(err,code,text){if(code===410){stopped=true;status('Sesión finalizada');return;}if(err||code!==200){status('Esperando a la PC');setTimeout(poll,2500);return;}var job;try{job=JSON.parse(text);}catch(e){setTimeout(poll,2000);return;}if(!job){status('Conectado. Esperando transferencia.');setTimeout(poll,1500);return;}status('Procesando '+job.name);var receiver=job.receiver||'puente-head.cgi';if(['puente-head.cgi','puente-dd.cgi','puente-cat.cgi'].indexOf(receiver)<0){status('Receptor no autorizado');stopped=true;return;}var url='/usbparts/sda1/'+receiver+'?'+key+'&'+job.op+'&'+job.name;request(url,job.op==='put'?'POST':'GET',job.data,function(e,c,result){request(host+'/result?key='+key+'&id='+encodeURIComponent(job.id),'POST',JSON.stringify({status:c||0,error:e||null,text:result||''}),function(){setTimeout(poll,1000);});});});}poll();
</script>
